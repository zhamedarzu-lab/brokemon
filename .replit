modules = ["nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Brokemon"

[[workflows.workflow]]
name = "Brokemon"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

# Vite serves on 3000 (see vite.config.ts). externalPort 80 is what the bare
# *.replit.dev URL resolves to, so the game answers there with no port suffix —
# which is what you want when opening it on a phone or tablet.
[[ports]]
localPort = 3000
externalPort = 80
